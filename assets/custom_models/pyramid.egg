<CoordinateSystem> { Z-up }

<Material> pyramid_mat {
  <Scalar> diffr { 0.8 }
  <Scalar> diffg { 0.4 }
  <Scalar> diffb { 0.1 }
  <Scalar> ambr { 0.8 }
  <Scalar> ambg { 0.4 }
  <Scalar> ambb { 0.1 }
  <Scalar> specr { 0.9 }
  <Scalar> specg { 0.7 }
  <Scalar> specb { 0.3 }
  <Scalar> shininess { 10.0 }
}

<VertexPool> pyramid_vpool {
  <Vertex> 0 { 0.0 0.0 1.0 }
  <Vertex> 1 { 1.0 1.0 0.0 }
  <Vertex> 2 { -1.0 1.0 0.0 }
  <Vertex> 3 { -1.0 -1.0 0.0 }
  <Vertex> 4 { 1.0 -1.0 0.0 }
}

<Group> pyramid {
  <Polygon> {
    <MRef> { pyramid_mat }
    <VertexRef> { 0 1 2 <Ref> { pyramid_vpool } }
  }
  <Polygon> {
    <MRef> { pyramid_mat }
    <VertexRef> { 0 2 3 <Ref> { pyramid_vpool } }
  }
  <Polygon> {
    <MRef> { pyramid_mat }
    <VertexRef> { 0 3 4 <Ref> { pyramid_vpool } }
  }
  <Polygon> {
    <MRef> { pyramid_mat }
    <VertexRef> { 0 4 1 <Ref> { pyramid_vpool } }
  }
  <Polygon> {
    <MRef> { pyramid_mat }
    <VertexRef> { 1 4 3 2 <Ref> { pyramid_vpool } }
  }
}